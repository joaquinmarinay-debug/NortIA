# Clave de la API de Anthropic para el chat con IA de la landing (api/chat.ts)
# y del agente de WhatsApp (api/whatsapp.ts). Nunca comitear el valor real —
# se configura como variable de entorno en Vercel.
ANTHROPIC_API_KEY=sk-ant-...

# Agente de WhatsApp (api/whatsapp.ts) — WhatsApp Business Platform (Meta Cloud API).
# Token permanente del System User de Meta Business, con permisos
# whatsapp_business_messaging y whatsapp_business_management.
WHATSAPP_TOKEN=...
# Phone Number ID que muestra Meta en WhatsApp > API Setup (no es el número en sí).
WHATSAPP_PHONE_NUMBER_ID=...
# String secreto elegido por nosotros — debe coincidir exactamente con el que
# se configura en Meta al crear el webhook (App > WhatsApp > Configuration).
WHATSAPP_VERIFY_TOKEN=...
